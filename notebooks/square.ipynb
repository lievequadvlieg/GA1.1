   "source": [
    "def multiply(a, b):\n",
    "    numberA = a\n",
    "    numberB = b\n",
    "    return print(f'result={numberA * numberB}')\n",
    "\n",
    "def square(x):\n",
    "    return print(multiply(x, x))"
   ]
  },
  {
