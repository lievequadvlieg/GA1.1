   "source": [
    "def substract(a, b):\n",
    "    c = a - b\n",
    "    return c\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "7f418fdc",
   "metadata": {},
   "outputs": [],
   "source": [
    "def distance_from_zero(x):\n",
    "    result=substract(0, x)\n",
    "    return print(f'distance from zero={abs(result)}')"
   ]
  },
